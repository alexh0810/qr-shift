rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // QRShift does not use the Firestore client SDK in the browser.
    // All reads and writes should go through server-side Next.js routes
    // backed by the Firebase Admin SDK, where owner/manager access is
    // validated with signed cookies and server-side checks.

    match /stores/{storeId} {
      allow read, write: if false;
    }

    match /employees/{employeeId} {
      allow read, write: if false;
    }

    match /timelogs/{timelogId} {
      allow read, write: if false;
    }

    // Deny any future collections by default until rules are designed for them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
